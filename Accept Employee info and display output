#include<iostream>
using namespace std;

class employee
{
    public: 
    int eid;
    string ename;
    float esalary;

    void input()
    {
      cout<<"Enter Employee ID: ";
      cin>>eid;
      cin.ignore();
      cout<<"Enter Name of Employee: ";
      getline(cin, ename);
      cout<<"Enter Salary of Employee: ";
      cin>>esalary;
    }
    void display()
    {
        cout<<"Employee ID is:- "<<eid<<endl;
        cout<<"Employee's Name is:- "<<ename<<endl;
        cout<<"Employee's Salary is:- "<<esalary<<endl;
    }
};

int main()
{
    employee e1;
    e1.input();
    e1.display();

    return 0;
}
